[Unit]
Description=Пограничная служба coreeuler: кэш чтения и очередь комментариев
After=network-online.target

[Service]
WorkingDirectory=/srv/edge
EnvironmentFile=/srv/edge/.env
ExecStart=/srv/edge/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8090
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

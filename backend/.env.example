# Адрес базы. На домашнем сервере — локальный PostgreSQL.
CORE_DATABASE_URL=postgresql+psycopg://coreeuler:пароль@127.0.0.1:5432/coreeuler

# Секрет агента новостей. Пустое значение полностью запрещает публикацию новостей.
CORE_NEWS_AGENT_TOKEN=

# Перец для необратимых хешей адресов и ключей. Обязательно заменить.
CORE_HASH_PEPPER=change-me

# За nginx включается доверие к заголовку X-Real-IP.
CORE_TRUST_PROXY_HEADERS=true

# Источники для браузерных запросов через запятую. Нужно только для локальной разработки.
# В продакшене пусто: сайт и API на одном домене.
CORE_CORS_ORIGINS=

CORE_COMMENT_RATE_LIMIT=5
CORE_COMMENT_RATE_WINDOW_SECONDS=600
CORE_AGENT_RATE_LIMIT=60
CORE_AGENT_RATE_WINDOW_SECONDS=3600
CORE_RATE_EVENT_TTL_HOURS=24

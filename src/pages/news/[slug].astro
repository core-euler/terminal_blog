---
// Прежний адрес новости без темы: перенаправляет на папку темы.
import { allNews, newsUrl } from '../../lib/news-static';

export const getStaticPaths = () =>
  allNews().map((news) => ({ params: { slug: news.slug }, props: { target: newsUrl(news) } }));

const { target } = Astro.props;
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <title>Переход на новый адрес</title>
    <link rel="canonical" href={target} />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
  </head>
  <body>
    <p>Новость переехала в папку темы: <a href={target}>{target}</a></p>
  </body>
</html>

---
import Editor from '../../../layouts/Editor.astro';
import Comments from '../../../components/Comments.astro';
import { allNews, summary, topicUrl } from '../../../lib/news-static';
import { newsBlocks } from '../../../lib/news-art';

export const getStaticPaths = () =>
  allNews().map((news) => ({
    params: { topic: news.topic, slug: news.slug },
    props: { news },
  }));

const { news } = Astro.props;
const description = summary(news.body, 200);
const blocks = newsBlocks(news);
---

<Editor
  title={news.title}
  description={description}
  ogType="article"
  tab="index.md"
  tabDir={`${news.topic}/`}
  path={`~/blog/news/${news.topic}/${news.slug}.md`}
  filetype="markdown"
>
  <div class="lines">
    <p class="post-foot">
      <a href={topicUrl(news.topic)}>← тема {news.topic}</a>
    </p>

    <article class="news-item h-entry">
      <header class="news-head">
        <h1 class="p-name">{news.title}</h1>
        <p class="meta">
          <time class="dt-published" datetime={news.event_date}>{news.event_date}</time>
          <span class="sep">·</span>
          <a class="p-category tag" href={topicUrl(news.topic)}>#{news.topic}</a>
          <span class="sep">·</span>
          <span>опубликовано {news.published_at.slice(0, 16).replace('T', ' ')}</span>
        </p>
      </header>

      <div class="news-body e-content">
        {
          blocks.map((block) => {
            if (block.kind === 'text') {
              return block.paragraphs.map((paragraph) => <p>{paragraph}</p>);
            }
            if (block.kind === 'rule') {
              return (
                <pre class="ascii-rule" data-ascii data-piece={block.slug} style="--ascii-size:10px">
                  {block.frame}
                </pre>
              );
            }
            return (
              <figure class="ascii-figure" data-ascii data-piece={block.slug} style="--ascii-size:13px">
                <pre class="ascii-art">{block.frame}</pre>
              </figure>
            );
          })
        }
      </div>

      {
        news.sources.length > 0 && (
          <section class="news-sources">
            <h2>Источники</h2>
            <ul>
              {news.sources.map((source) => (
                <li>
                  <a href={source.url} rel="nofollow noopener" target="_blank">
                    {source.title ?? source.url}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <Comments slug={news.slug} />
    </article>
  </div>
</Editor>

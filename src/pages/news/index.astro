---
import Editor from '../../layouts/Editor.astro';
import { SITE } from '../../site.config';

const description =
  'Лента новостей и обсуждение: комментарий может оставить человек или внешний агент, имя по желанию.';
---

<Editor
  title="Новости"
  description={description}
  tab="news"
  path="~/blog/news"
  filetype="feed"
>
  <div class="lines">
    <header class="intro" id="news-intro">
      <h1>Новости</h1>
      <p class="p-note">{description}</p>
    </header>

    <p class="news-state" id="news-state" role="status" aria-live="polite">читаю ленту…</p>
    <div id="news-view" hidden></div>

    <noscript>
      <p class="news-state">Для ленты и комментариев нужен JavaScript.</p>
    </noscript>

    <p class="post-foot" id="news-back" hidden>
      <a href="/news/" data-nav>← вся лента</a>
    </p>
  </div>

  <script>
    import {
      ApiError,
      fetchComments,
      fetchNews,
      fetchNewsItem,
      postComment,
      type CommentItem,
      type NewsItem,
    } from '../../lib/api';

    const view = document.querySelector<HTMLElement>('#news-view')!;
    const state = document.querySelector<HTMLElement>('#news-state')!;
    const intro = document.querySelector<HTMLElement>('#news-intro')!;
    const back = document.querySelector<HTMLElement>('#news-back')!;
    const scroller = document.querySelector<HTMLElement>('[data-scroller]');

    const COMMENT_MAX = 2000;
    const NAME_MAX = 40;

    function node(tag: string, className?: string, text?: string): HTMLElement {
      const element = document.createElement(tag);
      if (className) element.className = className;
      if (text !== undefined) element.textContent = text;
      return element;
    }

    function when(value: string): string {
      const date = new Date(value);
      if (Number.isNaN(date.getTime())) return value;
      const pad = (number: number) => String(number).padStart(2, '0');
      return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())} ${pad(date.getHours())}:${pad(date.getMinutes())}`;
    }

    function summary(text: string): string {
      const flat = text.replace(/\s+/g, ' ').trim();
      return flat.length > 160 ? `${flat.slice(0, 157).trimEnd()}…` : flat;
    }

    function fail(error: unknown): string {
      if (error instanceof ApiError) return error.message;
      return 'не получилось загрузить ленту';
    }

    function renderList(items: NewsItem[], total: number): void {
      intro.hidden = false;
      back.hidden = true;

      if (items.length === 0) {
        view.replaceChildren(node('p', 'news-empty', 'Пока ни одной новости.'));
        return;
      }

      const list = document.createElement('ol');
      list.className = 'feed';
      for (const news of items) {
        const row = node('li', 'h-entry');

        const time = node('time', 'dt-published', news.event_date);
        time.dateTime = news.event_date;

        const link = node('a', 'feed-title p-name u-url', news.title) as HTMLAnchorElement;
        link.href = `/news/?item=${encodeURIComponent(news.slug)}`;
        link.dataset.nav = '';

        const text = node('p', 'p-summary', summary(news.body));

        const tags = node('p', 'tags');
        const tag = node('a', 'tag p-category', `#${news.topic}`) as HTMLAnchorElement;
        tag.href = `/news/?item=${encodeURIComponent(news.slug)}`;
        tag.dataset.nav = '';
        tags.append(tag);

        row.append(time, link, text, tags);
        list.append(row);
      }

      const foot = node('p', 'news-total', `всего ${total}`);
      view.replaceChildren(list, foot);
    }

    function renderComments(container: HTMLElement, slug: string, comments: CommentItem[]): void {
      const head = node('h2', undefined, `Комментарии (${comments.length})`);
      container.append(head);

      if (comments.length === 0) {
        container.append(node('p', 'news-empty', 'Пока никто не написал.'));
      } else {
        const list = document.createElement('ol');
        list.className = 'comment-list';
        for (const comment of comments) {
          const row = node('li', 'comment');
          const meta = node('p', 'comment-head');
          meta.append(node('span', `comment-name is-${comment.author.kind}`, comment.author.name));
          meta.append(node('span', 'sep', '·'));
          meta.append(node('span', 'comment-time', when(comment.created_at)));
          row.append(meta, node('p', 'comment-text', comment.text));
          list.append(row);
        }
        container.append(list);
      }

      const form = document.createElement('form');
      form.className = 'comment-form';
      form.autocomplete = 'off';

      const name = document.createElement('input');
      name.className = 'comment-name-input';
      name.name = 'name';
      name.type = 'text';
      name.maxLength = NAME_MAX;
      name.placeholder = 'имя или пусто — будет аноним';

      const text = document.createElement('textarea');
      text.className = 'comment-text-input';
      text.name = 'text';
      text.required = true;
      text.maxLength = COMMENT_MAX;
      text.rows = 3;
      text.placeholder = 'что думаете';

      const submit = document.createElement('button');
      submit.className = 'comment-submit';
      submit.type = 'submit';
      submit.textContent = 'отправить';

      const note = node('p', 'form-note');
      note.setAttribute('aria-live', 'polite');

      form.append(name, text, submit, note);
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!text.value.trim()) {
          note.className = 'form-note is-error';
          note.textContent = 'пустой комментарий не отправить';
          return;
        }

        submit.disabled = true;
        note.className = 'form-note';
        note.textContent = 'отправляю…';

        try {
          const receipt = await postComment(slug, text.value, name.value);
          form.reset();
          note.className = 'form-note is-ok';
          note.textContent = `${receipt.message}: появится после проверки`;
        } catch (error) {
          note.className = 'form-note is-error';
          note.textContent = fail(error);
        } finally {
          submit.disabled = false;
        }
      });

      container.append(node('p', 'comment-rule', 'Комментарий проходит проверку: без политики, порно, наркотиков, насилия и терроризма.'), form);
    }

    function renderDetail(news: NewsItem, comments: CommentItem[]): void {
      intro.hidden = true;
      back.hidden = false;

      const article = document.createElement('article');
      article.className = 'news-item';

      const header = node('header', 'news-head');
      header.append(node('h1', undefined, news.title));

      const meta = node('p', 'meta');
      const time = node('time', 'dt-published', news.event_date);
      time.dateTime = news.event_date;
      meta.append(time, node('span', 'sep', '·'));
      meta.append(node('a', 'tag', `#${news.topic}`));
      meta.append(node('span', 'sep', '·'));
      meta.append(node('span', undefined, `опубликовано ${when(news.published_at)}`));
      header.append(meta);

      const body = node('div', 'news-body');
      for (const paragraph of news.body.split(/\n{2,}/)) {
        const text = paragraph.replace(/\s*\n\s*/g, ' ').trim();
        if (text) body.append(node('p', undefined, text));
      }

      article.append(header, body);

      if (news.sources.length > 0) {
        const sources = node('section', 'news-sources');
        sources.append(node('h2', undefined, 'Источники'));
        const list = document.createElement('ul');
        for (const source of news.sources) {
          const item = document.createElement('li');
          const link = node('a', undefined, source.title ?? source.url) as HTMLAnchorElement;
          link.href = source.url;
          link.rel = 'nofollow noopener';
          link.target = '_blank';
          item.append(link);
          list.append(item);
        }
        sources.append(list);
        article.append(sources);
      }

      const discussion = node('section', 'comments');
      renderComments(discussion, news.slug, comments);
      article.append(discussion);

      view.replaceChildren(article);
    }

    async function route(): Promise<void> {
      const slug = new URLSearchParams(location.search).get('item');
      state.hidden = false;
      state.textContent = 'читаю…';
      view.hidden = true;

      try {
        if (slug) {
          const [news, discussion] = await Promise.all([fetchNewsItem(slug), fetchComments(slug)]);
          renderDetail(news, discussion.items);
        } else {
          const page = await fetchNews();
          renderList(page.items, page.total);
        }
        state.hidden = true;
        view.hidden = false;
      } catch (error) {
        console.error('лента:', error);
        state.textContent = fail(error);
      }
    }

    document.addEventListener('click', (event) => {
      const target = event.target as HTMLElement | null;
      const link = target?.closest<HTMLAnchorElement>('a[data-nav]');
      if (!link || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey) return;
      event.preventDefault();
      history.pushState(null, '', link.href);
      scroller?.scrollTo({ top: 0 });
      void route();
    });

    window.addEventListener('popstate', () => void route());
    void route();
  </script>
</Editor>

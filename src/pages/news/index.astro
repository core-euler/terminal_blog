---
import Editor from '../../layouts/Editor.astro';
import { allNews, generatedAt, summary } from '../../lib/news-static';

const description =
  'Лента новостей и обсуждение: комментарий может оставить человек или внешний агент, имя по желанию.';
const items = allNews();
---

<Editor title="Новости" description={description} tab="news" path="~/blog/news" filetype="feed">
  <div class="lines">
    <header class="intro" id="news-intro">
      <h1>Новости</h1>
      <p class="p-note">{description}</p>
    </header>

    {
      items.length === 0 ? (
        <p class="news-empty">Пока ни одной новости. Лента обновится после следующей сборки.</p>
      ) : (
        <ol class="feed">
          {items.map((news) => (
            <li class="h-entry">
              <time class="dt-published" datetime={news.event_date}>
                {news.event_date}
              </time>
              <a class="feed-title p-name u-url" href={`/news/${news.slug}/`}>
                {news.title}
              </a>
              <p class="p-summary">{summary(news.body)}</p>
              <p class="tags">
                <span class="tag p-category">#{news.topic}</span>
              </p>
            </li>
          ))}
        </ol>
      )
    }

    {items.length > 0 && <p class="news-total">всего {items.length}</p>}

    {
      generatedAt && (
        <p class="p-note">
          снимок ленты от {generatedAt.slice(0, 16).replace('T', ' ')} — страница собрана целиком, без
          запросов к серверу
        </p>
      )
    }
  </div>
</Editor>

---
import Editor from '../../layouts/Editor.astro';
import { allNews, generatedAt, topics, topicUrl } from '../../lib/news-static';

const description =
  'Новости по темам: тема — папка, внутри лента. Обсуждение открыто человеку и внешнему агенту, имя по желанию.';
const folders = topics();
const total = allNews().length;
---

<Editor title="Новости" description={description} tab="news" path="~/blog/news" filetype="feed">
  <div class="lines">
    <header class="intro" id="news-intro">
      <h1>Новости</h1>
      <p class="p-note">{description}</p>
    </header>

    {
      folders.length === 0 ? (
        <p class="news-empty">Пока ни одной новости. Лента обновится после следующей сборки.</p>
      ) : (
        <ul class="folders">
          {folders.map((folder) => (
            <li>
              <a class="folder-row" href={topicUrl(folder.name)}>
                <span class="folder-name">{folder.name}</span>
                <span class="folder-meta">
                  {folder.count}
                  {' '}
                  {folder.count === 1 ? 'новость' : folder.count < 5 ? 'новости' : 'новостей'}
                </span>
                <time class="folder-date" datetime={folder.latest}>
                  {folder.latest}
                </time>
              </a>
            </li>
          ))}
        </ul>
      )
    }

    {
      total > 0 && (
        <p class="news-total">
          тем {folders.length}, новостей {total}
        </p>
      )
    }

    {
      generatedAt && (
        <p class="p-note">
          снимок ленты от {generatedAt.slice(0, 16).replace('T', ' ')} — страница собрана целиком, без
          запросов к серверу
        </p>
      )
    }
  </div>
</Editor>

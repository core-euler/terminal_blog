---
import Editor from '../layouts/Editor.astro';
import PostList from '../components/PostList.astro';
import { SITE } from '../site.config';
import { getPublishedPosts, postUrl } from '../lib/posts';

const posts = await getPublishedPosts();
const siteUrl = new URL('/', Astro.site).href;
const person = {
  '@type': 'Person',
  name: SITE.author.name,
  description: SITE.author.note,
  url: SITE.author.url,
  sameAs: SITE.author.links.map((link) => link.href),
};
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: SITE.seoTitle,
    description: SITE.description,
    url: siteUrl,
    inLanguage: SITE.lang,
    author: person,
    blogPost: posts.map((post) => ({
      '@type': 'BlogPosting',
      headline: post.data.title,
      datePublished: post.data.date.toISOString(),
      url: new URL(postUrl(post.id), Astro.site).href,
    })),
  },
  { '@context': 'https://schema.org', ...person },
];
---

<Editor title={SITE.title} jsonLd={jsonLd} tab="feed" path="~/blog" filetype="feed">
  <div class="lines">
    <header class="intro h-card">
      <h1 class="has-cursor">
        <a class="p-name u-url" rel="me" href={SITE.author.url}>{SITE.author.name}</a>
      </h1>
      <p class="p-note">{SITE.author.note}</p>
      <p class="meta">
        <a href="/rss.xml">rss</a>
        <span class="sep" aria-hidden="true">·</span>
        {SITE.author.links.map((link) => (
          <>
            <a href={link.href} rel="me">{link.label}</a>
            <span class="sep" aria-hidden="true">·</span>
          </>
        ))}
        <span>{posts.length} записей</span>
        <span class="sep" aria-hidden="true">·</span>
        <a href="/portfolio/">проекты</a>
      </p>
    </header>

    <section aria-labelledby="feed-title">
      <h2 id="feed-title">Записи</h2>
      <PostList posts={posts} />
    </section>
  </div>
</Editor>

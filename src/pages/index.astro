---
import Editor from '../layouts/Editor.astro';
import PostList from '../components/PostList.astro';
import { SITE } from '../site.config';
import { getPublishedPosts } from '../lib/posts';

const posts = await getPublishedPosts();
---

<Editor title={SITE.title} tab="feed" path="~/blog" filetype="feed">
  <div class="lines">
    <header class="intro h-card">
      <h1 class="has-cursor">
        <a class="p-name u-url" rel="me" href={SITE.author.url}>{SITE.author.name}</a>
      </h1>
      <p class="p-note">{SITE.author.note}</p>
      <p class="meta">
        <a href="/rss.xml">rss</a>
        <span class="sep" aria-hidden="true">·</span>
        <span>{posts.length} записей</span>
      </p>
    </header>

    <section aria-labelledby="feed-title">
      <h2 id="feed-title">Записи</h2>
      <PostList posts={posts} />
    </section>
  </div>
</Editor>

---
import Editor from '../../layouts/Editor.astro';
import PostList from '../../components/PostList.astro';
import { getPublishedPosts, postUrl, type Post } from '../../lib/posts';
import { SITE } from '../../site.config';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({
    params: { tag },
    props: { tag, posts: posts.filter((p) => p.data.tags.includes(tag)) },
  }));
}

const { tag, posts } = Astro.props as { tag: string; posts: Post[] };
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `#${tag}`,
  description: `Записи по теме «${tag}» на coreeuler.art.`,
  inLanguage: SITE.lang,
  url: new URL(Astro.url.pathname, Astro.site).href,
  hasPart: posts.map((post) => ({
    '@type': 'BlogPosting',
    headline: post.data.title,
    datePublished: post.data.date.toISOString(),
    url: new URL(postUrl(post.id), Astro.site).href,
  })),
};
---

<Editor
  title={`#${tag}`}
  description={`Записи по теме «${tag}»: ${posts.length} шт.`}
  jsonLd={jsonLd}
  tab={`#${tag}`} path={`~/blog/tags/${tag}`} filetype="feed">
  <div class="lines">
    <h1 class="has-cursor">#{tag}</h1>
    <p class="meta"><span>{posts.length} записей</span><span class="sep" aria-hidden="true">·</span><a href="/">← все записи</a></p>
    <PostList posts={posts} />
  </div>
</Editor>

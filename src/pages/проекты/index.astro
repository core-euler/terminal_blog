---
import Editor from '../../layouts/Editor.astro';
import { SITE } from '../../site.config';
import { getProjectsByCategory, projectUrl, shotUrl } from '../../lib/projects';

const groups = await getProjectsByCategory();
const total = groups.reduce((sum, group) => sum + group.projects.length, 0);
const pageUrl = new URL('/проекты/', Astro.site).href;
const description = 'Портфолио: AI-автоматизация и мобильные приложения. Задача, роль, стек и снимки экранов.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Проекты',
  description,
  url: pageUrl,
  inLanguage: SITE.lang,
  author: { '@type': 'Person', name: SITE.author.name, url: SITE.author.url },
  hasPart: groups.flatMap((group) =>
    group.projects.map((project) => ({
      '@type': 'CreativeWork',
      name: project.data.title,
      description: project.data.summary,
      url: new URL(projectUrl(project.id), Astro.site).href,
    })),
  ),
};
---

<Editor
  title="Проекты"
  description={description}
  jsonLd={jsonLd}
  tab="проекты"
  path="~/blog/проекты"
  filetype="портфолио"
  activePath="проекты"
>
  <div class="lines">
    <header>
      <h1 class="has-cursor">Проекты</h1>
      <p class="meta">
        <span>{total} проекта</span>
        {' '}<span class="sep" aria-hidden="true">·</span>{' '}
        <span>AI-автоматизация и мобильные приложения</span>
      </p>
    </header>

    {
      groups.map((group) => (
        <section aria-labelledby={`cat-${group.category}`}>
          <h2 id={`cat-${group.category}`}>{group.title}</h2>
          <ul class="projects">
            {group.projects.map((project) => (
              <li class="project-card">
                <a class="project-cover" href={projectUrl(project.id)} tabindex="-1" aria-hidden="true">
                  <img
                    src={shotUrl(project.id, project.data.shots[0].file)}
                    alt=""
                    loading="lazy"
                    decoding="async"
                  />
                </a>
                <h3>
                  <a class="project-title" href={projectUrl(project.id)}>{project.data.title}</a>
                </h3>
                <p class="project-summary">{project.data.summary}</p>
                {project.data.stack.length > 0 && (
                  <p class="stack">
                    {project.data.stack.map((item) => <code>{item}</code>)}
                  </p>
                )}
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</Editor>

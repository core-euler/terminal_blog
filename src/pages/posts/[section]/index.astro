---
import Editor from '../../../layouts/Editor.astro';
import PostList from '../../../components/PostList.astro';
import AsciiArt from '../../../components/AsciiArt.astro';
import { pieceFor } from '../../../lib/ascii';
import { getPublishedPosts, postUrl, type Post } from '../../../lib/posts';
import { SITE } from '../../../site.config';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const sections = [...new Set(posts.map((post) => post.id.split('/')[0]))];
  return sections.map((section) => ({
    params: { section },
    props: { section, posts: posts.filter((post) => post.id.split('/')[0] === section) },
  }));
}

const { section, posts } = Astro.props as { section: string; posts: Post[] };
// Разделы разные, а темы у них общие: сверху пьеса про работу с кодом,
// снизу — про сеть и публикацию. Отпечаток слага делает выбор разным.
const topPiece = pieceFor(['dev'], `${section}-top`);
const bottomPiece = pieceFor(['web'], `${section}-bottom`);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: section,
  description: `Раздел «${section}»: ${posts.length} записей.`,
  inLanguage: SITE.lang,
  url: new URL(Astro.url.pathname, Astro.site).href,
  hasPart: posts.map((post) => ({
    '@type': 'BlogPosting',
    headline: post.data.title,
    datePublished: post.data.date.toISOString(),
    url: new URL(postUrl(post.id), Astro.site).href,
  })),
};
---

<Editor
  title={`${section} — записи`}
  description={`Раздел «${section}»: ${posts.length} записей.`}
  jsonLd={jsonLd}
  tab={section} path={`~/blog/posts/${section}`} filetype="feed">
  <div class="lines">
    <h1 class="has-cursor">{section}</h1>
    <p class="meta"><span>{posts.length} записей</span><span class="sep" aria-hidden="true">·</span><a href="/posts/">← все записи</a></p>
    <AsciiArt piece={topPiece} size={8} />
    <PostList posts={posts} />
    <AsciiArt piece={bottomPiece} size={10} />
  </div>
</Editor>

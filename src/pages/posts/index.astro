---
import Editor from '../../layouts/Editor.astro';
import PostList from '../../components/PostList.astro';
import { getPublishedPosts, postUrl } from '../../lib/posts';
import { SITE } from '../../site.config';

const posts = await getPublishedPosts();
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'posts',
  description: `Все записи блога coreeuler.art: ${posts.length} шт.`,
  inLanguage: SITE.lang,
  url: new URL(Astro.url.pathname, Astro.site).href,
  hasPart: posts.map((post) => ({
    '@type': 'BlogPosting',
    headline: post.data.title,
    datePublished: post.data.date.toISOString(),
    url: new URL(postUrl(post.id), Astro.site).href,
  })),
};
---

<Editor
  title="posts — все записи"
  description={`Все записи блога: ${posts.length} шт.`}
  jsonLd={jsonLd}
  tab="posts" path="~/blog/posts" filetype="feed">
  <div class="lines">
    <h1 class="has-cursor">posts</h1>
    <p class="meta"><span>{posts.length} записей</span><span class="sep" aria-hidden="true">·</span><a href="/">← главная</a></p>
    <PostList posts={posts} />
  </div>
</Editor>

---
import { render } from 'astro:content';
import Editor from '../../layouts/Editor.astro';
import { SITE } from '../../site.config';
import {
  getAllProjects,
  projectCategory,
  projectUrl,
  PROJECT_CATEGORIES,
  type Project,
} from '../../lib/projects';

export async function getStaticPaths() {
  const projects = await getAllProjects();
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props as { project: Project };
const { Content } = await render(project);
const [, slug] = project.id.split('/');
const category = projectCategory(project.id);
const pageUrl = new URL(projectUrl(project.id), Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: project.data.title,
  description: project.data.summary,
  url: pageUrl,
  inLanguage: SITE.lang,
  keywords: project.data.stack.join(', '),
  creator: { '@type': 'Person', name: SITE.author.name, url: SITE.author.url },
  ...(project.data.links.length > 0 && {
    sameAs: project.data.links.map((link) => link.href),
  }),
};
const facts = [
  { label: 'роль', value: project.data.role },
  ...(project.data.stack.length > 0
    ? [{ label: 'стек', value: project.data.stack.join(', ') }]
    : []),
  ...(project.data.period ? [{ label: 'срок', value: project.data.period }] : []),
  ...(project.data.result ? [{ label: 'итог', value: project.data.result }] : []),
];
---

<Editor
  title={project.data.title}
  description={project.data.summary}
  ogType="article"
  jsonLd={jsonLd}
  tab="index.md"
  tabDir={`${slug}/`}
  path={`~/blog/portfolio/${project.id}/index.md`}
  activePath={`portfolio/${project.id}`}
>
  <article class="lines h-entry">
    <header>
      <h1 class="p-name has-cursor">{project.data.title}</h1>
      <p class="meta">
        <a href="/portfolio/">{PROJECT_CATEGORIES[category]}</a>
        {' '}<span class="sep" aria-hidden="true">·</span>{' '}
        <a class="p-author h-card" href={SITE.author.url}>{SITE.author.name}</a>
      </p>
      <p class="lead p-summary">{project.data.summary}</p>
    </header>

    <dl class="facts">
      {
        facts.map((fact) => (
          <>
            <dt>{fact.label}</dt>
            <dd>{fact.value}</dd>
          </>
        ))
      }
    </dl>

    <div class="post-body e-content">
      <Content />
    </div>

    {
      project.data.links.length > 0 && (
        <p class="meta">
          {project.data.links.map((link) => (
            <a href={link.href} rel="noopener">{link.label}</a>
          ))}
        </p>
      )
    }

    <footer>
      <p class="meta"><a href="/portfolio/">← все проекты</a></p>
    </footer>
  </article>
</Editor>

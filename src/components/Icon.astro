---
/** Иконки живут спрайтом в layout, здесь — только ссылка на нужный символ. */
interface Props {
  name: 'chevron' | 'folder' | 'folder-open' | 'markdown' | 'image' | 'video' | 'file' | 'menu' | 'close' | 'list';
  class?: string;
}
const { name, class: cls } = Astro.props;
---

<svg class:list={['icon', cls]} aria-hidden="true">
  <use href={`#i-${name}`} />
</svg>

---
/**
 * Анимированный ASCII-арт из библиотеки ascii-magic-art.
 * В разметку кладётся кадр, снятый на сборке: он остаётся без JS и при reduced motion.
 * Оживление берёт на себя src/scripts/ascii-mount.ts, подключённый в раскладке.
 */
import { frameOf } from '../lib/ascii';

interface Props {
  /** Имя пьесы из библиотеки, напр. `file-tree`. */
  piece: string;
  /** Размер символа в пикселях на широком экране. */
  size?: number;
  /** Подпись под артом. */
  caption?: string;
  /** Скорость воспроизведения, 1 — обычная. */
  speed?: number;
}

const { piece, size = 12, caption, speed = 1 } = Astro.props;
const frame = await frameOf(piece);
---

<figure
  class="ascii-figure"
  data-ascii
  data-piece={piece}
  data-speed={speed}
  style={`--ascii-size:${size}px`}
>
  <pre class="ascii-art" aria-hidden="true">{frame}</pre>
  {caption && <figcaption class="ascii-caption">{caption}</figcaption>}
</figure>

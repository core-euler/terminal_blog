---
/*
 * Иконки рисуются один раз на страницу, а в дереве и табах стоят ссылки на
 * них. Иначе каждая строка дерева тащит копию контура, и на странице
 * набирается три десятка килобайт одинаковой разметки.
 *
 * Вид (обводка, толщина, размер) задаётся в css на `.icon`, поэтому ссылке
 * достаточно имени. `viewBox` живёт на самом символе.
 */
---

<svg class="icon-sprite" aria-hidden="true" focusable="false" width="0" height="0">
  <symbol id="i-chevron" viewBox="0 0 16 16"><path d="M6 4l4 4-4 4" /></symbol>
  <symbol id="i-folder" viewBox="0 0 16 16">
    <path d="M2 4.5A1.5 1.5 0 0 1 3.5 3h2.6l1.5 1.5h4.9A1.5 1.5 0 0 1 14 6v5.5a1.5 1.5 0 0 1-1.5 1.5h-9A1.5 1.5 0 0 1 2 11.5z" />
  </symbol>
  <symbol id="i-folder-open" viewBox="0 0 16 16">
    <path d="M2 11.5V4.5A1.5 1.5 0 0 1 3.5 3h2.6l1.5 1.5h4a1.5 1.5 0 0 1 1.5 1.5v.8M2 11.5l1.6-4.2A1.2 1.2 0 0 1 4.7 6.5h9l-1.9 5.6a1.3 1.3 0 0 1-1.2.9H3.5A1.5 1.5 0 0 1 2 11.5z" />
  </symbol>
  <symbol id="i-markdown" viewBox="0 0 16 16">
    <rect x="1.5" y="3.5" width="13" height="9" rx="1.5" />
    <path d="M4 10V6l1.5 1.8L7 6v4M10.5 6v4M9 8.6l1.5 1.4L12 8.6" />
  </symbol>
  <symbol id="i-image" viewBox="0 0 16 16">
    <rect x="2" y="2.5" width="12" height="11" rx="1.5" />
    <circle cx="6" cy="6.2" r="1.2" />
    <path d="M2.5 12l3.8-3.6 2.6 2.4 1.9-1.6 3 2.6" />
  </symbol>
  <symbol id="i-video" viewBox="0 0 16 16">
    <rect x="1.5" y="3.5" width="9.5" height="9" rx="1.5" />
    <path d="M11 7l3.5-2v6L11 9" />
  </symbol>
  <symbol id="i-file" viewBox="0 0 16 16"><path d="M4 1.8h5l3 3v9.4H4zM9 1.8v3h3" /></symbol>
  <symbol id="i-menu" viewBox="0 0 16 16"><path d="M2.5 4.5h11M2.5 8h11M2.5 11.5h11" /></symbol>
  <symbol id="i-close" viewBox="0 0 16 16"><path d="M4 4l8 8M12 4l-8 8" /></symbol>
  <symbol id="i-list" viewBox="0 0 16 16">
    <path d="M5.5 4.5h8M5.5 8h8M5.5 11.5h8M2.5 4.5h.01M2.5 8h.01M2.5 11.5h.01" />
  </symbol>
</svg>

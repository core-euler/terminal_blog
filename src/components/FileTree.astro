---
import { SITE } from '../site.config';
import { getPostTree } from '../lib/tree';
import { topics, topicUrl } from '../lib/news-static';
import Icon from './Icon.astro';
import TreeItem from './TreeItem.astro';

interface Props {
  activePath?: string;
}
const { activePath } = Astro.props;
const tree = await getPostTree();
const newsTopics = topics();
const pathname = Astro.url.pathname;
---

<nav id="files" class="pane tree" popover aria-labelledby="files-title">
  <div class="pane-bar tree-bar">
    <h2 id="files-title" class="pane-title">
      <a href="/">{SITE.title}</a>
    </h2>
    <button class="icon-btn only-mobile" type="button" popovertarget="files" popovertargetaction="hide" aria-label="Закрыть дерево файлов">
      <Icon name="close" />
    </button>
  </div>
  <ul class="tree-root">
    <li>
      <details open>
        <summary class="row" style="--depth:0">
          <Icon name="chevron" class="chev" />
          <Icon name="folder" class="ico ico-closed" />
          <Icon name="folder-open" class="ico ico-open" />
          <a
            class:list={['name', 'name-link', { 'is-active': pathname === '/posts/' }]}
            href="/posts/"
            aria-current={pathname === '/posts/' ? 'page' : undefined}
          >posts</a>
        </summary>
        <ul style="--guide:0">
          {tree.map((node) => <TreeItem node={node} depth={1} activePath={activePath} />)}
        </ul>
      </details>
    </li>
    <li>
      <details open>
        <summary class="row" style="--depth:0">
          <Icon name="chevron" class="chev" />
          <Icon name="folder" class="ico ico-closed" />
          <Icon name="folder-open" class="ico ico-open" />
          <a class="name name-link" href="/news/">news</a>
        </summary>
        <ul style="--guide:0">
          {newsTopics.map((topic) => {
            const href = topicUrl(topic.name);
            return (
              <li>
                <a
                  class:list={['row', 'file', { 'is-active': pathname === href }]}
                  style="--depth:1"
                  href={href}
                  aria-current={pathname === href ? 'page' : undefined}
                >
                  <Icon name="list" class="ico" />
                  <span class="name">{topic.name}</span>
                </a>
              </li>
            );
          })}
        </ul>
      </details>
    </li>
  </ul>
  <div class="pane-art" data-pane-art="algorithms" aria-hidden="true"></div>
</nav>
